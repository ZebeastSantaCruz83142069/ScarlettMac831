From 3fb5e70649ccfb19ce269347ea03faa8523dfddd Mon Sep 17 00:00:00 2001
From: jgrizon
Date: Fri, 27 Nov 2026 16:57:50 +0100
Subject: [PATCH] gpu: the BVH builder runs in 32-lane halves when its programs
 are exact (VICTORY_BUILDER_EXACT=1, off by default)

builder::runs() opens when every pipeline is made and every one translated
without an approximate half-local answer, and logs one line naming the ones
that did not (hash and the read or LDS it approximated). Off, the halves hold
it back as before.

Generated by Mistral Vibe.

Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 crates/victory-gpu/src/shader_cache.rs | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/crates/victory-gpu/src/shader_cache.rs b/crates/victory-gpu/src/shader_cache.rs
index 7bf583f..914f527 100644
--- a/crates/victory-gpu/src/shader_cache.rs
+++ b/crates/victory-gpu/src/shader_cache.rs
@@ -967,6 +967,21 @@ mod tests {
     fn entries_round_trip_and_reject_damage() {
         let bytes = encode(&Ok(shader()));
         assert_eq!(decode(&bytes), Some(Ok(shader())));
+        // What the translation left approximate comes back with it, and the
+        // entry says the translation is not exact (`exact_halves`), which
+        // `VICTORY_BUILDER_EXACT` reads.
+        let back = decode(&bytes).and_then(Result::ok);
+        assert!(!shader().exact_halves());
+        assert_eq!(
+            back.as_ref().and_then(|s| s.inexact_halves.clone()),
+            shader().inexact_halves
+        );
+        let exact = HostShader {
+            inexact_halves: None,
+            ..shader()
+        };
+        assert!(exact.exact_halves());
+        assert_eq!(decode(&encode(&Ok(exact.clone()))), Some(Ok(exact)));
         assert_eq!(decode(&bytes[..bytes.len() - 1]), None);
         assert_eq!(decode(&[bytes.as_slice(), &[0]].concat()), None);
         assert_eq!(decode(b"VSH0"), None);
