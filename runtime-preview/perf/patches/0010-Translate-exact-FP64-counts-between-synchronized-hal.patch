diff --git a/crates/victory-gpu/src/shader_cache.rs b/crates/victory-gpu/src/shader_cache.rs
index b06fd78..8d9c730 100644
--- a/crates/victory-gpu/src/shader_cache.rs
+++ b/crates/victory-gpu/src/shader_cache.rs
@@ -378,6 +378,14 @@ pub(crate) fn translation_build(options: victory_shader::emit::Options) -> &'sta
     } else {
         key
     };
+    let key = if options.halves_exchange && victory_shader::emit::f64_count_exchange() {
+        let mut h = blake3::Hasher::new();
+        h.update(&key);
+        h.update(b"halves f64 count");
+        *h.finalize().as_bytes()
+    } else {
+        key
+    };
     if key == *build {
         return build;
     }
