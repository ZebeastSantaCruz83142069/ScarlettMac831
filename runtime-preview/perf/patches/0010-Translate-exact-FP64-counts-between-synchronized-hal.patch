diff --git a/crates/victory-shader/src/emit/lower/f64_sum.rs b/crates/victory-shader/src/emit/lower/f64_sum.rs
index 57776ca..db39e4c 100644
--- a/crates/victory-shader/src/emit/lower/f64_sum.rs
+++ b/crates/victory-shader/src/emit/lower/f64_sum.rs
@@ -63,7 +63,14 @@ impl Lower<'_> {
         if self.mask_data == MaskData::None {
             return Err("a wave reduction in a mesh shader");
         }
-        self.same_half("a wave reduction over both 32-lane halves (wave64 on a 32-lane host)")?;
+        let enabled = self.halves
+            && !self.one_host_wave()
+            && self.x.mac.exchange
+            && super::super::f64_count_exchange();
+        let across = enabled && (!high || self.exchange_halves_in(self.cur_ir));
+        if !across {
+            self.same_half("a wave reduction over both 32-lane halves (wave64 on a 32-lane host)")?;
+        }
         let (lo, hi) = (self.i32_of(lo)?, self.i32_of(hi)?);
         if self.s.m.int_value(lo) != Some(0) || self.s.m.int_value(hi) != Some(ONE_HIGH.into()) {
             return Err("a whole-wave sum of 64-bit floats other than of the constant 1.0");
@@ -93,6 +100,13 @@ impl Lower<'_> {
             119,
             &[x, sum, unsigned],
         );
+        let n = if across {
+            use super::super::wave::Op;
+            self.exchanged_reduction(Op::AddU, n, None, 0)
+                .ok_or("an integer FP64 lane count")?
+        } else {
+            n
+        };
         Ok(count_f64_high(&mut self.s.m, c, n))
     }
 }
diff --git a/crates/victory-shader/src/emit/mod.rs b/crates/victory-shader/src/emit/mod.rs
index 0d4fc84..df6d56e 100644
--- a/crates/victory-shader/src/emit/mod.rs
+++ b/crates/victory-shader/src/emit/mod.rs
@@ -330,6 +330,12 @@ pub use shader::{
     VIEW_WRITES_BYTES,
 };
 
+/// Whether the sum of FP64 ones may use the exact integer exchange across host waves.
+pub fn f64_count_exchange() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_HALVES_F64_COUNT").is_some_and(|v| v == "1"))
+}
