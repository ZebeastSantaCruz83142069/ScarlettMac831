+#[test]
+fn an_exact_f64_lane_count_can_exchange_the_integer_totals() {
+    const SUBTEST: &str = "VICTORY_TEST_F64_EXCHANGE";
+    match std::env::var(SUBTEST).as_deref() {
+        Ok("1") => {
+            let result = lowered_wave64(&count_of_lanes(0x3FF0_0000), true, false, true)
+                .expect("an exact integer count across both waves");
+            assert_eq!(result.wave_size, Some(32));
+            assert_eq!(result.stored_constants, [None]);
+            assert_eq!(result.exchanges, 1);
+            assert!(result.barriers > 0);
+            assert!(lowered_wave64(&count_of_lanes(0x4000_0000), true, false, true).is_err());
+            assert!(lowered_wave64(&count_of_lanes(0x3FF0_0000), true, false, false).is_err());
+        }
+        Ok("0") => {
+            assert!(lowered_wave64(&count_of_lanes(0x3FF0_0000), true, false, true).is_err());
+        }
+        _ => {
+            for on in ["0", "1"] {
+                let child = std::process::Command::new(std::env::current_exe().unwrap())
+                    .args(["--exact", "emit::f64_tests::an_exact_f64_lane_count_can_exchange_the_integer_totals"])
+                    .env(SUBTEST, on)
+                    .env("VICTORY_HALVES_F64_COUNT", on)
+                    .output()
+                    .unwrap();
+                assert!(child.status.success(), "{}", String::from_utf8_lossy(&child.stdout));
+            }
+        }
+    }
+}
+
+#[cfg(windows)]
+#[test]
+#[ignore = "requires a 32-lane hardware adapter and VICTORY_HALVES_F64_COUNT=1"]
+fn exact_f64_count_matches_console_on_32_lane_gpu() {
+    use super::host::{Dispatch, Host, Root, Stride, View};
+    let lowered = lowered_wave64(&count_of_lanes(0x3FF0_0000), true, false, true).unwrap();
+    let shader = super::halves_tests::shader(lowered);
+    let (adapter, host) = Host::each_hardware()
+        .into_iter()
+        .find(|(_, host)| matches!(host.wave32(), Ok(true)))
+        .expect("a 32-lane hardware adapter");
+    let (root, pso) = host.compute_pipeline(&shader).unwrap();
+    let views = [
+        View::Texture(1, 1, &[[0.0; 4]]),
+        View::Buffer { data: &[0; 4], stride: Stride::Structured(16) },
+        View::RawUav(64 * 8),
+    ];
+    let ud = vec![0; shader.user_data_dwords().max(1) as usize];
+    let output = host.dispatch(&root, &pso, &Dispatch {
+        roots: vec![(0, Root::Constants(ud))],
+        views: &views,
+        samplers: &[],
+        groups: [1, 1, 1],
+    }).unwrap();
+    let values: Vec<_> = output[0].chunks_exact(8).map(|row| row[0]).collect();
+    assert_eq!(values, [34f32.to_bits(); 64], "{adapter}");
+    eprintln!("{adapter}: all 64 lanes returned 34.0");
+}
