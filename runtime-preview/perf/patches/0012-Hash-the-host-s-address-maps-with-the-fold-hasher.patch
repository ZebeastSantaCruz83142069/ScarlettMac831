+/// The fold alone, for a map that always wants it: no state to carry, so a
+/// map built with it is as cheap to hold as one with the standard hasher.
+#[derive(Default, Clone, Copy)]
+pub(crate) struct FoldHashing;
+
+impl BuildHasher for FoldHashing {
+    type Hasher = Hashed;
+
+    fn build_hasher(&self) -> Hashed {
+        Hashed::Fold(0)
+    }
+}
+
+/// A map keyed by our own addresses or indices (host copies, device
+/// pointers, slot numbers), hashed by multiply-and-fold: the standard
+/// hasher's protection against chosen keys buys nothing on keys the title
+/// does not choose, and costs the submitting thread some 7 ms a frame
+/// (`host::HostList`'s maps, `descriptor::host`'s widening).
+pub(crate) type FoldMap<K, V> = HashMap<K, V, FoldHashing>;
+
+/// [`FoldMap`]'s set.
+pub(crate) type FoldSet<K> = HashSet<K, FoldHashing>;
+
 /// [`Hashing`]'s hasher.
 pub(crate) enum Hashed {
     Standard(std::hash::DefaultHasher),
