+    /// The fold-alone hasher holds 10,000 addresses: every key inserted,
+    /// read back with its own value and no other, then removed.
+    #[test]
+    fn the_fold_map_holds_addresses() {
+        let mut map: FoldMap<usize, u32> = FoldMap::default();
+        let keys: Vec<usize> = (0..10_000).map(|i| 0x7FF6_0000_0000 + i * 4096).collect();
+        for (i, key) in keys.iter().enumerate() {
+            assert_eq!(map.insert(*key, i as u32), None);
+        }
+        assert_eq!(map.len(), keys.len());
+        for (i, key) in keys.iter().enumerate() {
+            assert_eq!(map.get(key), Some(&(i as u32)));
+        }
+        assert_eq!(map.get(&0x7FF6_0000_0000usize.wrapping_add(1)), None);
+        // Every key its own bucket, not a run of neighbours.
+        let buckets: HashSet<u64> = keys.iter().map(|k| FoldHashing.hash_one(k) & 0x3FFF).collect();
+        assert!(buckets.len() > 6_000, "10,000 addresses into 16,384 buckets: {}", buckets.len());
+        for (i, key) in keys.iter().enumerate() {
+            assert_eq!(map.remove(key), Some(i as u32));
+        }
+        assert!(map.is_empty());
+        assert_eq!(map.get(&keys[0]), None);
+    }
+
