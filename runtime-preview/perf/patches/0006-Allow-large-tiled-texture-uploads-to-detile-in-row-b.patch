 }
 
+const DETILE_BAND_MIN: usize = 2 * 1024 * 1024;
+
+fn row_workers() -> Option<&'static rayon::ThreadPool> {
+    // A refresh holds its staging lock. These workers run only detile jobs,
+    // and an existing Rayon worker must never yield into another refresh.
+    if rayon::current_thread_index().is_some() {
+        return None;
+    }
+    static WORKERS: OnceLock<Option<rayon::ThreadPool>> = OnceLock::new();
+    WORKERS.get_or_init(|| {
+        if !crate::switch::on("VICTORY_DETILE_ROWS") {
+            return None;
+        }
+        match rayon::ThreadPoolBuilder::new()
+            .num_threads(2)
+            .thread_name(|i| format!("detile rows {i}"))
+            .build()
+        {
+            Ok(pool) => {
+                tracing::info!("VICTORY_DETILE_ROWS=1: large tiled 2D uploads can detile in bands");
+                Some(pool)
+            }
+            Err(error) => {
+                tracing::warn!(%error, "could not start the row detile workers");
+                None
+            }
+        }
+    }).as_ref()
+}
+
+fn band_height(
+    layout: &victory_formats::texture::Layout,
+    mip: u32,
+    rows: u32,
+    depth: u32,
+    len: usize,
+) -> Option<u32> {
+    use victory_formats::texture::{Dimension, Swizzle};
+    if depth != 1 || rows < 4 || len < DETILE_BAND_MIN
+        || layout.desc.dimension != Dimension::Tex2d
+        || layout.desc.samples != 1
+        || layout.desc.swizzle == Swizzle::LINEAR
+        || !layout.mips.get(mip as usize).is_some_and(|m| m.height == rows && m.depth == 1)
+    {
+        return None;
+    }
+    Some(rows.div_ceil(2).next_multiple_of(2))
+}
+
+#[allow(clippy::too_many_arguments)]
+fn detile_upload(
+    layout: &victory_formats::texture::Layout,
+    tiled: &[u8],
+    (mip, slice): (u32, u32),
+    linear: &mut [u8],
+    pitch: usize,
+    rows: u32,
+    depth: u32,
+    pool: Option<&rayon::ThreadPool>,
+) -> Result<(), victory_formats::texture::Error> {
+    if let Some(pool) = pool
+        && let Some(band) = band_height(layout, mip, rows, depth, linear.len())
+        && let Some(bytes) = pitch.checked_mul(band as usize).filter(|&bytes| bytes != 0)
+    {
+        use victory_formats::texture::Error;
+        let row_bytes = layout.mips[mip as usize].width as usize * layout.desc.element_bytes as usize;
+        let need = (rows as usize - 1)
+            .checked_mul(pitch)
+            .and_then(|offset| offset.checked_add(row_bytes))
+            .ok_or(Error::TooSmall)?;
+        if linear.len() < need || pitch < row_bytes {
+            return Err(Error::TooSmall);
+        }
+        return pool.install(|| {
+            linear[..need].par_chunks_mut(bytes).enumerate().try_for_each(|(index, chunk)| {
+                let first = index as u32 * band;
+                layout.detile_rows(tiled, mip, slice, chunk, pitch, first..rows.min(first + band))
+            })
+        });
+    }
+    layout.detile(tiled, mip, slice, linear, pitch, pitch * rows as usize)
+}
