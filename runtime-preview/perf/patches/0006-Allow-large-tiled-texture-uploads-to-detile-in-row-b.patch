     use super::*;
 
+    #[test]
+    fn staged_row_bands_match_the_serial_upload() {
+        use victory_formats::texture::{Desc, Dimension, Layout, Swizzle};
+        let pool = rayon::ThreadPoolBuilder::new().num_threads(2).build().unwrap();
+        let layout = Layout::new(&Desc {
+            dimension: Dimension::Tex2d,
+            width: 2049,
+            height: 2051,
+            depth: 2,
+            mips: 2,
+            element_bytes: 16,
+            block: 4,
+            samples: 1,
+            swizzle: Swizzle::SW_64KB_D,
+        }).unwrap();
+        let tiled: Vec<_> = (0..layout.size).map(|i| (i ^ (i >> 8)) as u8).collect();
+        let mip = &layout.mips[0];
+        let rows = mip.height;
+        let row_bytes = mip.width as usize * 16;
+        let pitch = row_bytes.next_multiple_of(256);
+        let len = (rows as usize - 1) * pitch + row_bytes;
+        let mut serial = vec![0x59; len];
+        let mut parallel = serial.clone();
+        layout.detile(&tiled, 0, 1, &mut serial, pitch, pitch * rows as usize).unwrap();
+        assert!(band_height(&layout, 0, rows, 1, len).is_some());
+        detile_upload(&layout, &tiled, (0, 1), &mut parallel, pitch, rows, 1, Some(&pool)).unwrap();
+        assert_eq!(parallel, serial);
+        let truncated = len - 1;
+        parallel.fill(0x59);
+        assert_eq!(
+            detile_upload(&layout, &tiled, (0, 1), &mut parallel[..truncated], pitch, rows, 1, Some(&pool)),
+            Err(victory_formats::texture::Error::TooSmall),
+        );
+        assert!(parallel.iter().all(|&byte| byte == 0x59));
+        assert_eq!(band_height(&layout, 0, rows, 2, len), None);
+        assert_eq!(band_height(&layout, 0, rows + 1, 1, len), None);
+    }
