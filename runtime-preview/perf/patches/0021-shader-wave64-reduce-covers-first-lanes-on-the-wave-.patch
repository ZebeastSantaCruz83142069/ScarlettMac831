+// ---- Wave-path control flow (checkpoint 0014) ----
+
+#[test]
+fn wave_path_follows_lane_branches_where_uniform_control_does_not() {
+    // v_cmpx_eq_u32 exec, 0, v0; s_cbranch_execz past a move; s_mov s2, 1; s_endpgm
+    let words = [0x7DA4_0080, 0xBF88_0001, 0xBE82_0381, S_ENDPGM];
+    let code: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+    let p = ir::build(&code, false, 256).unwrap();
+    let st = structure::structure(&p).unwrap();
+    // Both waves execute both sides of a lane branch: the path is the same.
+    let path = super::barriers::wave_path(&p, &st);
+    assert!(path.iter().all(|&u| u), "{path:?}");
+    // The strict form still refuses to call it uniform.
+    let strict = super::barriers::uniform_control(&p, &st);
+    assert!(!strict[1] && !strict[2], "{strict:?}");
+}
