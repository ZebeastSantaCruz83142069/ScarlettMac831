index 0000000..18e1a3b
--- /dev/null
+++ b/crates/victory-hle/src/modules/gameinput_script.rs
@@ -0,0 +1,200 @@
+use std::fs::File;
+use std::io::{self, Read, Seek, SeekFrom};
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+const READ_INTERVAL: Duration = Duration::from_millis(50);
+const TAP: Duration = Duration::from_millis(200);
+const MAX_LINE: usize = 128;
+const MAX_PENDING: usize = 256;
+
+struct Press {
+    starts: Instant,
+    ends: Instant,
+    key: u8,
+}
+
+#[derive(Default)]
+pub(super) struct FileQueue {
+    file: Option<File>,
+    next_read: Option<Instant>,
+    line: Vec<u8>,
+    skip_line: bool,
+    scheduled: Vec<Press>,
+}
+
+impl FileQueue {
+    #[cfg(windows)]
+    pub(super) fn from_env() -> Self {
+        let Some(path) = std::env::var_os("VICTORY_KEYS_FILE").filter(|path| !path.is_empty())
+        else {
+            return Self::default();
+        };
+        Self::open(Path::new(&path)).unwrap_or_else(|error| {
+            tracing::warn!(%error, "could not open VICTORY_KEYS_FILE");
+            Self::default()
+        })
+    }
+
+    fn open(path: &Path) -> io::Result<Self> {
+        if !path.metadata()?.is_file() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "expected a regular file",
+            ));
+        }
+        let mut file = File::open(path)?;
+        file.seek(SeekFrom::End(0))?;
+        Ok(Self {
+            file: Some(file),
+            ..Self::default()
+        })
+    }
+
+    pub(super) fn update(&mut self, now: Instant, held: &mut Vec<u8>) {
+        self.scheduled.retain(|press| press.ends > now);
+        if let Some(file) = self.file.as_mut()
+            && self.next_read.is_none_or(|next| now >= next)
+        {
+            self.next_read = Some(now + READ_INTERVAL);
+            let mut bytes = [0; 4096];
+            match file.read(&mut bytes) {
+                Ok(size) => self.read_lines(now, &bytes[..size]),
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                Err(error) => {
+                    tracing::warn!(%error, "could not read VICTORY_KEYS_FILE");
+                    self.file = None;
+                    self.scheduled.clear();
+                }
+            }
+        }
+        for press in &self.scheduled {
+            if now >= press.starts && !held.contains(&press.key) {
+                held.push(press.key);
+            }
+        }
+    }
+
+    fn read_lines(&mut self, now: Instant, bytes: &[u8]) {
+        for &byte in bytes {
+            if byte == b'\n' {
+                if !self.skip_line
+                    && let Ok(line) = std::str::from_utf8(&self.line)
+                {
+                    if line.trim().eq_ignore_ascii_case("release") {
+                        self.scheduled.clear();
+                    } else if self.scheduled.len() < MAX_PENDING
+                        && let Some(press) = parse(line, now)
+                    {
+                        self.scheduled.push(press);
+                    }
+                }
+                self.line.clear();
+                self.skip_line = false;
+            } else if !self.skip_line {
+                if self.line.len() < MAX_LINE {
+                    self.line.push(byte);
+                } else {
+                    self.skip_line = true;
+                }
+            }
+        }
+    }
+}
+
+fn parse(line: &str, now: Instant) -> Option<Press> {
+    let mut fields = line.split_ascii_whitespace();
+    let key = virtual_key(fields.next()?)?;
+    let duration = |value: &str, max: u64| {
+        Duration::try_from_secs_f64(value.parse().ok()?)
+            .ok()
+            .filter(|time| *time <= Duration::from_secs(max))
+    };
+    let held = match fields.next() {
+        Some(value) => duration(value, 60)?,
+        None => TAP,
+    };
+    let delay = match fields.next() {
+        Some(value) => duration(value, 600)?,
+        None => Duration::ZERO,
+    };
+    if held.is_zero() || fields.next().is_some() {
+        return None;
+    }
+    let starts = now + delay;
+    Some(Press {
+        starts,
+        ends: starts + held,
+        key,
+    })
+}
+
+pub(super) fn virtual_key(key: &str) -> Option<u8> {
+    Some(match key {
+        "Enter" => 0x0D,
+        "Esc" => 0x1B,
+        "Tab" => 0x09,
+        "Back" => 0x08,
+        "Up" => 0x26,
+        "Down" => 0x28,
+        "Left" => 0x25,
+        "Right" => 0x27,
+        k if k.len() == 1 && k.as_bytes()[0].is_ascii_alphanumeric() => {
+            k.as_bytes()[0].to_ascii_uppercase()
+        }
+        _ => return None,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use std::io::Write;
+
+    use super::*;
+
+    fn keys(queue: &mut FileQueue, now: Instant) -> Vec<u8> {
+        let mut held = Vec::new();
+        queue.update(now, &mut held);
+        held
+    }
+
+    #[test]
+    fn live_taps_holds_and_delays_expire() {
+        let mut writer = tempfile::NamedTempFile::new().unwrap();
+        writeln!(writer, "L 60").unwrap();
+        let mut queue = FileQueue::open(writer.path()).unwrap();
+        let start = Instant::now();
+        assert_eq!(keys(&mut queue, start), []);
+
+        writeln!(writer, "Enter\nW 2\nJ 1 0.5").unwrap();
+        let poll = start + READ_INTERVAL;
+        let check =
+            |queue: &mut FileQueue, millis| keys(queue, poll + Duration::from_millis(millis));
+        assert_eq!(check(&mut queue, 0), [0x0D, b'W']);
+        assert_eq!(check(&mut queue, 199), [0x0D, b'W']);
+        assert_eq!(check(&mut queue, 200), [b'W']);
+        assert_eq!(check(&mut queue, 500), [b'W', b'J']);
+        assert_eq!(check(&mut queue, 1500), [b'W']);
+        assert_eq!(check(&mut queue, 2000), []);
+    }
+
+    #[test]
+    fn complete_lines_only_and_release_cancels_pending_input() {
+        let mut writer = tempfile::NamedTempFile::new().unwrap();
+        let mut queue = FileQueue::open(writer.path()).unwrap();
+        let now = Instant::now();
+        write!(writer, "W 2").unwrap();
+        assert_eq!(keys(&mut queue, now), []);
+
+        writeln!(
+            writer,
+            "\n{}L\nW NaN\nJ 1 4\nI 1 0 extra",
+            " ".repeat(MAX_LINE)
+        )
+        .unwrap();
+        assert_eq!(keys(&mut queue, now + READ_INTERVAL), [b'W']);
+        writeln!(writer, "release\nS 1").unwrap();
+        assert_eq!(keys(&mut queue, now + 2 * READ_INTERVAL), [b'S']);
+        assert_eq!(keys(&mut queue, now + Duration::from_secs(5)), []);
+    }
+}
