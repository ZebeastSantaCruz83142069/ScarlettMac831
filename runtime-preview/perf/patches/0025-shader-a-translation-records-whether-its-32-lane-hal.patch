+/// A read across the halves answered from the reader's own half is what
+/// makes a translation approximate (`HostShader::inexact_halves`, which
+/// `VICTORY_BUILDER_EXACT` tests); the same program handed over exactly, or
+/// one that stays in its halves, is exact.
+#[test]
+fn the_half_local_answers_are_what_make_a_translation_approximate() {
+    for (what, words, refusal) in across() {
+        let local = lowered(&words, 64, 0, true, true).expect("half-local reads");
+        assert_eq!(local.approx, Some(refusal), "{what}");
+        // Without them the Mac port's hand-over answers exactly.
+        let handed = lowered(&words, 64, 0, true, false).expect("handed over");
+        assert_eq!(handed.approx, None, "{what}");
+        // One wave64 of 64 lanes, and a group of one host wave, read the
+        // console's own lanes: exact either way.
+        let whole = lowered(&words, 64, 0, false, true).expect("one wave64");
+        assert_eq!(whole.approx, None, "{what}");
+        let one_wave = lowered(&words, 32, 0, true, true).expect("one host wave");
+        assert_eq!(one_wave.approx, None, "{what}");
+    }
+    let within = lowered(&within_halves(), 64, 0, true, true).expect("in halves");
+    assert_eq!(within.approx, None, "a program that stays in its halves");
+}
+
+/// LDS one console wave64 shares, left unordered between the two host waves
+/// (`Local::lds`), is approximate too, and refused without that setting.
+#[test]
+fn shared_lds_left_unordered_is_approximate() {
+    let lds = |reads| lower::HalvesLocal { reads, lds: true };
+    let l = lowered_with(&shared_lds(), 64, 256, true, lds(false)).expect("shared LDS");
+    assert_eq!(
+        l.approx,
+        Some("LDS one console wave64 shares without barriers, on a host of 32-lane waves")
+    );
+    assert!(
+        lowered_with(&shared_lds(), 64, 256, true, Default::default()).is_err(),
+        "refused without it"
+    );
+    // LDS ordered by a barrier is exact.
+    let synced = lowered_with(&shared_lds(), 128, 256, true, Default::default());
+    assert_eq!(
+        synced.map(|l| l.approx).unwrap_or(None),
+        None,
+        "several console waves order their LDS"
+    );
+}
