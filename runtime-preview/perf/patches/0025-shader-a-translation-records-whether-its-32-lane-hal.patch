+/// Whether `VICTORY_BUILDER_EXACT=1`: the builder's dispatches run even
+/// where its 64-lane programs run as two 32-lane halves, as long as every
+/// one of them translated exactly — no read across the halves answered from
+/// the reader's own half, no LDS left unordered between them
+/// (`HostShader::inexact_halves`; `VICTORY_WAVE64_REDUCE=1` makes wave
+/// reductions, prefixes, first-lane and cross-half lane reads exact
+/// exchanges). Off: the halves hold it back on their own, as before.
+fn builder_exact() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = crate::switch::on("VICTORY_BUILDER_EXACT");
+        if on {
+            tracing::info!(
+                "VICTORY_BUILDER_EXACT=1: the BVH builder runs in 32-lane halves when each of its programs translates exactly"
+            );
+        }
+        on
+    })
+}
