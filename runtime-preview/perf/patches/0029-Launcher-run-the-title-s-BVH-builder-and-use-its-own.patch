From 0059fa8a83488ca072374d8d7c46fc5bd964cdac Mon Sep 17 00:00:00 2001
From: jgrizon
Date: Fri, 27 Nov 2026 17:59:02 +0100
Subject: [PATCH] Launcher: run the title's BVH builder and use its own
 lighting

VICTORY_WAVE64_REDUCE=1 makes the builder's cross-half reads exact, and
VICTORY_BUILDER_EXACT=1 then lets all 53 builder programs run. With the
structure built, the title's probes light faces and unlit surfaces
correctly, so VICTORY_AMBIENT=0 leaves its result alone.
Cost on a 24 GB M5 Pro, release: 424 and 464 world frames in the first
120 s against 519 without; slowest 5% of frames 0.75-1.07 s against 0.40 s.
Export VICTORY_BUILDER_EXACT=0 VICTORY_AMBIENT=1.0 for the faster look.
---
 tools/macos/play-main-mac.sh | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tools/macos/play-main-mac.sh b/tools/macos/play-main-mac.sh
index b363f90..5e4f6be 100755
--- a/tools/macos/play-main-mac.sh
+++ b/tools/macos/play-main-mac.sh
@@ -8,7 +8,8 @@ d() { eval "[ -n \"\${$1+x}\" ]" || export "$1=$2"; }
 d VICTORY_PATCH_MASKED all;        d VICTORY_FAULT_TRACKING 1
 d VICTORY_HALVES_LOCAL 1;          d VICTORY_HALVES_SHARED_LDS 1
 d VICTORY_HALVES_EXCHANGE 1;       d VICTORY_HALVES_WALK 1
-d VICTORY_GUARD_LOOKUP 1;          d VICTORY_AMBIENT 1.0
+d VICTORY_WAVE64_REDUCE 1;         d VICTORY_BUILDER_EXACT 1
+d VICTORY_GUARD_LOOKUP 1;          d VICTORY_AMBIENT 0
 d VICTORY_MAPDATA_BUDGET 40;       d VICTORY_COPY_ORDER split
 d VICTORY_BATCH_CLAMPS 1;          d VICTORY_UAV_SIZE_LEVEL0 07f451a14b13fecb
 d VICTORY_TEXTURE_BACK 256x256f41,256x256f16,64x64f16,128x128f36
-- 
2.56.0

