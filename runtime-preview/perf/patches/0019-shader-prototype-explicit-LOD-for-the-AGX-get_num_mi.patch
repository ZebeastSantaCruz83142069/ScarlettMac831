+/// Whether `VICTORY_PS_LOD_EXPLICIT=1` computes a 2D `image_get_lod`'s level
+/// of detail from coarse derivatives and the level-0 size instead of
+/// `dx.op.calculateLod`: D3DMetal on AGX M1 fails a mesh/PS pipeline with
+/// `air.get_num_mip_levels_`, which its calculateLod lowering needs. Part of
+/// the shader cache key.
+pub fn ps_lod_explicit() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_PS_LOD_EXPLICIT").as_deref() == Ok("1"))
+}
+
+/// Whether a level query is computed where [`ps_lod_explicit`] says: in a 2D
+/// pixel program, not with 16-bit coordinates (whose sizes and gradients the
+/// path is not written for).
+fn lod_explicit(flag: bool, stage: HwStage, kind: u32, a16: bool) -> bool {
+    flag && stage == HwStage::Ps && kind == 2 && !a16
+}
