+
+// ---- Explicit level of detail (checkpoint 0012) ----
+
+#[test]
+fn only_a_2d_pixels_level_query_is_computed_explicitly() {
+    assert!(super::lod_explicit(true, HwStage::Ps, 2, false));
+    assert!(!super::lod_explicit(false, HwStage::Ps, 2, false));
+    // 16-bit coordinates: the sizes and gradients the path uses are not theirs.
+    assert!(!super::lod_explicit(true, HwStage::Ps, 2, true));
+    // A cube's or a compute program's keeps calculateLod.
+    assert!(!super::lod_explicit(true, HwStage::Ps, 5, false));
+    assert!(!super::lod_explicit(true, HwStage::Cs, 2, false));
+}
