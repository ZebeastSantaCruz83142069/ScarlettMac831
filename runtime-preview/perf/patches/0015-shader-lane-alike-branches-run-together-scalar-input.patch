+// ---- Lane-alike branches (runtime-preview/checkpoint 0011) ----
+
+#[test]
+fn a_lane_branch_on_a_lane_alike_condition_runs_together() {
+    // v_cmpx_eq_u32 exec, 0, v0; s_cbranch_execz past a move; s_mov_b32 s3, 1;
+    // s_endpgm: the move runs in some lanes of the console wave only.
+    let words = [0x7DA4_0080, 0xBF88_0001, 0xBE83_0381, S_ENDPGM];
+    let code: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+    let p = ir::build(&code, false, 256).unwrap();
+    let st = structure::structure(&p).unwrap();
+    // The lane conditions the compare made (`halves::lane_uniform`'s alike).
+    let lane: std::collections::HashSet<_> = st
+        .exits
+        .iter()
+        .filter_map(|e| match *e {
+            structure::LaneExit::Branch { when, .. } => Some(when),
+            _ => None,
+        })
+        .flat_map(|w| st.bools.support(w).to_vec())
+        .filter_map(|a| match a {
+            structure::Atom::Lane(v) => Some(v),
+            _ => None,
+        })
+        .collect();
+    assert!(!lane.is_empty(), "a lane branch is on a lane condition");
+    // Not known to be one per console wave: only its lanes run the move.
+    let without = super::barriers::in_step(&p, &st, &Default::default());
+    assert!(!without[1], "{without:?}");
+    // Known to be: both host waves run it together, as they do a scalar.
+    let with = super::barriers::in_step(&p, &st, &lane);
+    assert!(with.iter().all(|&s| s), "{with:?}");
+}
