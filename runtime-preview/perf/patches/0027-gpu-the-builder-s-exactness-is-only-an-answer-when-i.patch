From 045704b93bc523b0444987e3de800554944a2621 Mon Sep 17 00:00:00 2001
From: jgrizon
Date: Fri, 27 Nov 2026 17:25:45 +0100
Subject: [PATCH] gpu: the builder's exactness is only an answer when it was
 asked for (VICTORY_BUILDER_EXACT=1, off by default)

With the flag off, or with a pipeline not made, the builder stays held back
by the halves as before: 'not asked' no longer reads as 'exact'. A shader
with no translation is no answer either. Tests the fold, not only opens().

Generated by Mistral Vibe.

Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 crates/victory-gpu/src/pipeline/builder.rs | 79 ++++++++++++++++------
 crates/victory-gpu/src/pipeline/make.rs    | 24 ++++---
 crates/victory-shader/src/emit/lower.rs    |  4 +-
 3 files changed, 75 insertions(+), 32 deletions(-)

diff --git a/crates/victory-gpu/src/pipeline/builder.rs b/crates/victory-gpu/src/pipeline/builder.rs
index 0c7b6d5..37ff084 100644
--- a/crates/victory-gpu/src/pipeline/builder.rs
+++ b/crates/victory-gpu/src/pipeline/builder.rs
@@ -122,27 +122,27 @@ pub(crate) fn runs() -> bool {
     if decided.0 == frame {
         return decided.1;
     }
-    let states: Vec<Option<bool>> = {
+    let pipelines: Vec<Arc<Pending>> = {
         let mut pipelines = PIPELINES.lock().unwrap_or_else(|e| e.into_inner());
         pipelines.retain(|p| p.strong_count() > 0);
-        let alive: Vec<Arc<Pending>> = pipelines.iter().filter_map(Weak::upgrade).collect();
-        alive.iter().map(|p| make::state(p)).collect()
+        pipelines.iter().filter_map(Weak::upgrade).collect()
     };
+    let states: Vec<Option<bool>> = pipelines.iter().map(|p| make::state(p)).collect();
     let halves = crate::shader_cache::halves_local_here();
     // `VICTORY_BUILDER_EXACT=1`: with the halves on, the programs' exactness
-    // decides too. Asked for only when it can change the decision.
-    let inexact: Vec<(String, String)> = if builder_exact() && all_made(&states) {
-        let mut pipelines = PIPELINES.lock().unwrap_or_else(|e| e.into_inner());
-        pipelines.retain(|p| p.strong_count() > 0);
-        pipelines
-            .iter()
-            .filter_map(Weak::upgrade)
-            .flat_map(|p| make::inexact_halves(&p))
-            .collect()
+    // decides too. Asked for only where it can change the decision; `None`
+    // (the flag off, or a pipeline not made) is not an answer, and leaves the
+    // halves' own rule in place.
+    let asked = builder_exact() && all_made(&states);
+    let inexact: Option<Vec<(String, String)>> = if asked {
+        let per: Option<Vec<Vec<(String, String)>>> =
+            pipelines.iter().map(|p| make::inexact_halves(p)).collect();
+        per.map(|v| v.concat())
     } else {
-        Vec::new()
+        None
     };
-    let open = opens(&states, halves, inexact.is_empty());
+    // Exact: asked for, every program's answer known, and none approximate.
+    let open = decides(&states, halves, inexact.as_deref());
     if open != decided.1 || !SAID.swap(true, Ordering::Relaxed) {
         let (made, refused) = (
             states.iter().filter(|s| **s == Some(true)).count(),
@@ -156,23 +156,23 @@ pub(crate) fn runs() -> bool {
             "BVH builder {}",
             if open {
                 "runs"
-            } else if halves && !(builder_exact() && all_made(&states)) {
-                "held back: its 64-lane programs would run as 32-lane halves on their own (VICTORY_HALVES_LOCAL, VICTORY_HALVES_SHARED_LDS)"
-            } else if halves {
+            } else if halves && asked {
                 "held back: some of its programs read across the 32-lane halves from their own half (VICTORY_BUILDER_EXACT asks for exact ones)"
+            } else if halves && !builder_exact() {
+                "held back: its 64-lane programs would run as 32-lane halves on their own (VICTORY_HALVES_LOCAL, VICTORY_HALVES_SHARED_LDS)"
             } else {
                 "held back: not all its pipelines are made"
             }
         );
         // One line naming them: each shader's hash and what it approximated.
-        if !inexact.is_empty() {
-            let named: Vec<String> = inexact
+        if let Some(named) = inexact.filter(|found| !found.is_empty()) {
+            let named: Vec<String> = named
                 .iter()
                 .map(|(hash, what)| format!("{hash}: {what}"))
                 .collect();
             tracing::info!(
                 frame,
-                count = inexact.len(),
+                count = named.len(),
                 "BVH builder programs that are not exact: {}",
                 named.join("; ")
             );
@@ -201,6 +201,19 @@ fn opens(states: &[Option<bool>], halves: bool, exact: bool) -> bool {
     all_made(states) && (!halves || exact)
 }
 
+/// Whether the builder's dispatches run this frame, from its pipelines'
+/// states and the programs that are not exact: every pipeline made, and in
+/// halves, asked for (`Some`, `VICTORY_BUILDER_EXACT=1`) with every program
+/// exact. `None` is "not asked" — the flag off, or a pipeline not made —
+/// and leaves the halves' own rule in place.
+fn decides(states: &[Option<bool>], halves: bool, inexact: Option<&[(String, String)]>) -> bool {
+    opens(
+        states,
+        halves,
+        inexact.is_some_and(<[(String, String)]>::is_empty),
+    )
+}
+
 /// Tests that set the builder's image, one at a time; each starts with
 /// no decision made.
 #[cfg(test)]
@@ -235,11 +248,35 @@ mod tests {
     #[test]
     fn in_halves_the_builder_runs_only_over_exact_programs() {
         assert!(opens(&[Some(true)], true, true), "exact in halves");
-        assert!(opens(&[], true, true));
+        assert!(opens(&[], true, true), "no builder: nothing to hold back");
         assert!(!opens(&[Some(true), Some(false)], true, true), "one refused");
         assert!(!opens(&[Some(true), None], true, true), "one still being made");
     }
 
+    /// The fold from what the pipelines say to the frame's decision: in
+    /// halves the builder is held back unless the exactness was asked for and
+    /// every program answered it (never on "not asked").
+    #[test]
+    fn in_halves_the_builder_runs_only_when_the_exactness_was_asked_for() {
+        let exact: [(String, String); 0] = [];
+        let one = [("a1b2c3d4".to_owned(), "a wave reduction".to_owned())];
+        assert!(
+            !decides(&[Some(true)], true, None),
+            "VICTORY_BUILDER_EXACT off: the halves hold it back"
+        );
+        assert!(
+            !decides(&[Some(true)], true, Some(&one)),
+            "one program approximates a read across the halves"
+        );
+        assert!(decides(&[Some(true)], true, Some(&exact)), "asked, all exact");
+        assert!(
+            !decides(&[Some(true), None], true, Some(&exact)),
+            "one still being made"
+        );
+        assert!(decides(&[Some(true)], false, None), "no halves: as before");
+        assert!(!decides(&[Some(true), Some(false)], false, None), "no halves, one refused");
+    }
+
     /// Pipelines are the builder's by their bytecode in its image, or by
     /// its code among the callers; not otherwise.
     #[test]
diff --git a/crates/victory-gpu/src/pipeline/make.rs b/crates/victory-gpu/src/pipeline/make.rs
index c4295d9..21966b4 100644
--- a/crates/victory-gpu/src/pipeline/make.rs
+++ b/crates/victory-gpu/src/pipeline/make.rs
@@ -234,17 +234,25 @@ pub(crate) fn state(p: &Pending) -> Option<bool> {
 
 /// `p`'s shaders that translated with an approximate half-local answer, each
 /// with its hash and what it approximated (`HostShader::inexact_halves`);
-/// nothing when every one of them is exact, or not translated yet.
-pub(crate) fn inexact_halves(p: &Pending) -> Vec<(String, String)> {
-    let mut found: Vec<(String, String)> = Vec::new();
+/// empty when every one of them is exact. `None` when one of them holds no
+/// translation, so nothing can be said about it.
+pub(crate) fn inexact_halves(p: &Pending) -> Option<Vec<(String, String)>> {
     #[cfg(windows)]
-    for s in &p.shaders {
-        if let Some(what) = s.translated().and_then(|t| t.host.inexact_halves.clone()) {
-            found.push((s.hash.clone(), what));
+    let found = {
+        let mut found = Vec::new();
+        for s in &p.shaders {
+            let t = s.translated()?;
+            if let Some(what) = t.host.inexact_halves.clone() {
+                found.push((s.hash.clone(), what));
+            }
         }
-    }
+        Some(found)
+    };
     #[cfg(not(windows))]
-    let _ = p;
+    let found = {
+        let _ = p;
+        Some(Vec::new())
+    };
     found
 }
 
