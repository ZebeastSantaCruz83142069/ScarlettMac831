+// ---- Gradient samples for pixel programs (checkpoint 0010) ----
+
+#[test]
+fn only_a_pixels_non_cube_implicit_sample_becomes_a_gradient_sample() {
+    assert!(super::sample_as_grad(true, HwStage::Ps, 2));
+    assert!(!super::sample_as_grad(false, HwStage::Ps, 2));
+    assert!(!super::sample_as_grad(true, HwStage::Cs, 2));
+    // A cube's gradients are the face's, which the explicit path already does.
+    assert!(!super::sample_as_grad(true, HwStage::Ps, 5));
+}
