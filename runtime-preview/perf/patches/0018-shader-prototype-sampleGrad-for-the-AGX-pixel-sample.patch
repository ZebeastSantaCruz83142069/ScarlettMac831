diff --git a/crates/victory-gpu/src/shader_cache.rs b/crates/victory-gpu/src/shader_cache.rs
index 8d9c730..ca53596 100644
--- a/crates/victory-gpu/src/shader_cache.rs
+++ b/crates/victory-gpu/src/shader_cache.rs
@@ -386,6 +386,26 @@ pub(crate) fn translation_build(options: victory_shader::emit::Options) -> &'sta
     } else {
         key
     };
+    // And the diagnostic emitter switches that change the DXIL
+    // (`VICTORY_BARRIER_LDS=1`, `VICTORY_PS_SAMPLE_GRAD=1`): a cached
+    // translation from the other setting must not be served. Off, each adds
+    // nothing.
+    let key = if victory_shader::emit::barrier_lds() {
+        let mut h = blake3::Hasher::new();
+        h.update(&key);
+        h.update(b"barrier lds");
+        *h.finalize().as_bytes()
+    } else {
+        key
+    };
+    let key = if victory_shader::emit::ps_sample_grad() {
+        let mut h = blake3::Hasher::new();
+        h.update(&key);
+        h.update(b"ps sample grad");
+        *h.finalize().as_bytes()
+    } else {
+        key
+    };
     if key == *build {
         return build;
     }
