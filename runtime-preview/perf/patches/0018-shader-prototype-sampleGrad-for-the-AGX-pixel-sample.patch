     *ON.get_or_init(|| std::env::var("VICTORY_BARRIER_LDS").as_deref() == Ok("1"))
 }
 
+/// Whether `VICTORY_PS_SAMPLE_GRAD=1` lowers a pixel shader's implicit-LOD
+/// `sample` to `sampleGrad` with explicit coarse derivatives: D3DMetal on
+/// AGX M1 fails some mesh/PS pipelines with `air.sample_.v4f32`. Part of the
+/// shader cache key.
+pub fn ps_sample_grad() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_PS_SAMPLE_GRAD").as_deref() == Ok("1"))
+}
+
+/// Whether a sample with an implicit level of detail becomes a `sampleGrad`
+/// with the coarse derivatives (one per direction) both directions take:
+/// with `VICTORY_PS_SAMPLE_GRAD`, in a pixel program, not a cube's sample
+/// (its gradients are the face's, which the explicit path already handles).
+fn sample_as_grad(flag: bool, stage: HwStage, kind: u32) -> bool {
+    flag && stage == HwStage::Ps && kind != 5
+}
+
 #[derive(Debug, Clone, Copy)]
 enum Val {
     I32(V),
@@ -9824,9 +9841,26 @@ impl<'a> Lower<'a> {
                         }
                     }
                     args.extend(&os);
-                    args.push(fu);
-                    self.s
-                        .op(c, "sample.f32", Attr::ReadOnly, self.s.t.res_ret, 60, &args)
+                    if sample_as_grad(ps_sample_grad(), self.x.native.stage, kind) {
+                        // Implicit LOD as an explicit gradient: D3DMetal on
+                        // AGX M1 cannot lower the `air.sample_` some mesh/PS
+                        // pipelines become, while `sampleGrad` is the same
+                        // lookup with the coarse derivatives the hardware
+                        // would take.
+                        let mut g = vec![fu; 6];
+                        for k in 0..spatial {
+                            g[k] = self.unary(83, cs[k]);
+                            g[3 + k] = self.unary(84, cs[k]);
+                        }
+                        args.extend(g);
+                        args.push(fu);
+                        self.s
+                            .op(c, "sampleGrad.f32", Attr::ReadOnly, self.s.t.res_ret, 63, &args)
+                    } else {
+                        args.push(fu);
+                        self.s
+                            .op(c, "sample.f32", Attr::ReadOnly, self.s.t.res_ret, 60, &args)
+                    }
                 }
                 61 => {
                     let bias = addr_val(self, 0)?;
