diff --git a/crates/victory-gpu/src/frame_wait.rs b/crates/victory-gpu/src/frame_wait.rs
new file mode 100644
index 0000000..1ef4176
--- /dev/null
+++ b/crates/victory-gpu/src/frame_wait.rs
@@ -0,0 +1,158 @@
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy)]
+pub(crate) enum Call {
+    Present,
+    PresentPump,
+    PresentSettle,
+    HostPresent,
+    FrameSleep,
+    QueueWait,
+    CpuFenceSettle,
+}
+
+const CALLS: usize = Call::CpuFenceSettle as usize + 1;
+const INTERVAL: Duration = Duration::from_secs(5);
+
+#[derive(Clone, Copy, Default)]
+struct Totals {
+    calls: u64,
+    elapsed: Duration,
+}
+
+struct Window {
+    since: Instant,
+    totals: [Totals; CALLS],
+}
+
+impl Window {
+    fn new(since: Instant) -> Self {
+        Self {
+            since,
+            totals: Default::default(),
+        }
+    }
+
+    fn complete(&mut self, call: Call, elapsed: Duration, now: Instant) -> Option<[Totals; CALLS]> {
+        let totals = &mut self.totals[call as usize];
+        totals.calls += 1;
+        totals.elapsed += elapsed;
+        if matches!(call, Call::Present) && now.saturating_duration_since(self.since) >= INTERVAL {
+            self.since = now;
+            return Some(std::mem::take(&mut self.totals));
+        }
+        None
+    }
+}
+
+#[cfg(windows)]
+pub(crate) use runtime::time;
+
+#[cfg(windows)]
+mod runtime {
+    use super::{Call, Window};
+    use std::sync::{Mutex, OnceLock};
+    use std::time::Instant;
+
+    static WINDOW: OnceLock<Option<Mutex<Window>>> = OnceLock::new();
+
+    pub(crate) struct Timer {
+        call: Call,
+        start: Instant,
+        window: &'static Mutex<Window>,
+    }
+
+    pub(crate) fn time(call: Call) -> Option<Timer> {
+        WINDOW
+            .get_or_init(|| {
+                (std::env::var("VICTORY_FRAME_WAITS").as_deref() == Ok("1"))
+                    .then(|| Mutex::new(Window::new(Instant::now())))
+            })
+            .as_ref()
+            .map(|window| Timer {
+                call,
+                start: Instant::now(),
+                window,
+            })
+    }
+
+    impl Drop for Timer {
+        fn drop(&mut self) {
+            let now = Instant::now();
+            let elapsed = now.duration_since(self.start);
+            let sample = self
+                .window
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .complete(self.call, elapsed, now);
+            let Some([present, pump, settle, show, sleep, queue, fence]) = sample else {
+                return;
+            };
+            let ms = |elapsed: std::time::Duration| {
+                elapsed.as_secs_f64() * 1000.0 / present.calls as f64
+            };
+            tracing::info!(
+                presents = present.calls,
+                present_ms = %format_args!("{:.1}", ms(present.elapsed)),
+                queue_pump_ms = %format_args!("{:.1}", ms(pump.elapsed)),
+                present_settle_ms = %format_args!("{:.1}", ms(settle.elapsed)),
+                host_present_ms = %format_args!("{:.1}", ms(show.elapsed)),
+                frame_sleep_calls = sleep.calls,
+                frame_sleep_ms = %format_args!("{:.1}", ms(sleep.elapsed)),
+                queue_wait_calls = queue.calls,
+                queue_wait_ms = %format_args!("{:.1}", ms(queue.elapsed)),
+                cpu_fence_settle_calls = fence.calls,
+                cpu_fence_settle_ms = %format_args!("{:.1}", ms(fence.elapsed)),
+                "frame wait wall time per completed PresentX"
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reports_each_phase_at_a_completed_present_and_resets() {
+        let start = Instant::now();
+        let mut window = Window::new(start);
+        let short = Duration::from_millis(10);
+        let phases = [
+            Call::PresentPump,
+            Call::PresentSettle,
+            Call::HostPresent,
+            Call::FrameSleep,
+            Call::QueueWait,
+            Call::CpuFenceSettle,
+        ];
+        for (index, phase) in phases.into_iter().enumerate() {
+            let elapsed = short * (index as u32 + 1);
+            assert!(window.complete(phase, elapsed, start + short).is_none());
+        }
+        assert!(
+            window
+                .complete(Call::Present, short, start + short)
+                .is_none()
+        );
+        assert!(
+            window
+                .complete(Call::FrameSleep, short, start + INTERVAL)
+                .is_none()
+        );
+
+        let report = window
+            .complete(Call::Present, short, start + INTERVAL)
+            .unwrap();
+        assert_eq!(report.map(|phase| phase.calls), [2, 1, 1, 1, 2, 1, 1]);
+        assert_eq!(
+            report.map(|phase| phase.elapsed.as_millis()),
+            [20, 10, 20, 30, 50, 50, 60]
+        );
+
+        let next = window
+            .complete(Call::Present, short, start + INTERVAL * 2)
+            .unwrap();
+        assert_eq!(next.map(|phase| phase.calls), [1, 0, 0, 0, 0, 0, 0]);
+    }
+}
