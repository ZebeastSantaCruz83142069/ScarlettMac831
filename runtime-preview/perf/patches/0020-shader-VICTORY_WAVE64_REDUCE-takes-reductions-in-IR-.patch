+/// Per block, whether every path from the entry to it goes through branches
+/// on scalars only ([`Atom::Uniform`]), at the IR level: no branch on a lane
+/// condition splits the console wave on the way. Unlike [`in_step`], the
+/// scalar values are not required to be provably alike, and loops on scalars
+/// do not block it (the caller decides when that is enough: a wave reduction
+/// whose loop count is the same for both host waves). A branch on a lane
+/// condition (or an indirect exit) makes both its sides not uniform.
+pub(crate) fn uniform_control(p: &Program, st: &Structured) -> Vec<bool> {
+    let n = st.exits.len().min(p.blocks.len());
+    let edge = |b: usize| match st.exits[b] {
+        LaneExit::Jump(_) | LaneExit::End => true,
+        LaneExit::Branch { when, .. } => st
+            .bools
+            .support(when)
+            .iter()
+            .all(|a| matches!(a, Atom::Uniform(_))),
+        LaneExit::Indirect => false,
+    };
+    // The greatest fixed point from `true`: a loop header stays true when its
+    // whole loop is on scalars, and a lane branch narrows both its sides.
+    let mut uniform = vec![true; n];
+    loop {
+        let mut changed = false;
+        for b in 0..n {
+            let next = b == 0
+                || {
+                    let preds = &p.blocks[b].preds;
+                    !preds.is_empty() && preds.iter().all(|&q| q < n && uniform[q] && edge(q))
+                };
+            if uniform[b] != next {
+                uniform[b] = next;
+                changed = true;
+            }
+        }
+        if !changed {
+            return uniform;
+        }
+    }
+}
