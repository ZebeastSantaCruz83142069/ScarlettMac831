From c0ec4e88fada6146e5c7029a40fcacb28d823204 Mon Sep 17 00:00:00 2001
From: jgrizon
Date: Fri, 27 Nov 2026 15:19:14 +0100
Subject: [PATCH] diagnostics: VICTORY_WAVE_WHY explains a first-lane answer
 (off by default)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

With VICTORY_WAVE_WHY set, a v_readfirstlane_b32 that no exact hand-over
covers — refused, or answered by the reader's own 32-lane half — logs the
instruction's offset, the value and the instruction that defined it, and
whether barrier placement saw its block as one every lane runs. For
attributing the remaining first_lane_across answers to their instruction
classes.

Ported from paveledits/ScarlettMac runtime-preview/checkpoint/patches/0007-diagnostics-VICTORY_WAVE_WHY-explains-wave64-retries.patch

Generated by Mistral Vibe.
Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 crates/victory-shader/src/emit/lower.rs | 26 +++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 4166ad2..279ccf1 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -7486,6 +7486,32 @@ impl<'a> Lower<'a> {
                         let r = self.first_lane_across(a)?;
                         return int(self, r);
                     }
+                    // `VICTORY_WAVE_WHY=1`: what the refusal (or the
+                    // half-local answer) is about, and where its value came
+                    // from, to attribute the remaining ones to their
+                    // instruction classes.
+                    if std::env::var_os("VICTORY_WAVE_WHY").is_some() {
+                        let from = v.src.first().and_then(|op| match *op {
+                            Operand::Vector { reg, .. } => inst.read(Reg::V(reg)),
+                            _ => None,
+                        });
+                        let def = from.and_then(|x| {
+                            self.x.p.blocks.iter().flat_map(|b| &b.insts).find_map(|i| {
+                                i.writes
+                                    .iter()
+                                    .find(|w| w.1 == x)
+                                    .map(|w| (i.name(), i.machine.offset, w.0))
+                            })
+                        });
+                        eprintln!(
+                            "FIRST_ACROSS at {:#x}: from {:?} defined by {:?}; block {} step={}",
+                            inst.machine.offset,
+                            from,
+                            def,
+                            self.cur_ir,
+                            self.step.get(self.cur_ir).copied().unwrap_or(false)
+                        );
+                    }
                     self.same_half(halves::FIRST_ACROSS)?;
                 }
                 let a = s(self, 0)?;
